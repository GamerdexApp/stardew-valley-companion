{
    "name": "stardew-valley-companion",
    "version": "1.1.0",
    "description": "A Stardew Valley progress tracker and companion app",
    "keywords": [
        "stardew-valley",
        "game-tracker",
        "nextjs",
        "react",
        "companion-app"
    ],
    "author": "chiefpansancolt",
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "postinstall": "bash scripts/copy-game-assets.sh"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "flowbite-react": "^0.12.17",
        "next": "^16.3.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-toastify": "^11.1.0",
        "stardew-valley-data": "^1.1.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.6",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-icons": "^5.7.0",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
